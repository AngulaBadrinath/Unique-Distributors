{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "type-check": "tsc --noEmit",
        "browser:check": "node scripts/browser-check.js",
        "browser:headed": "node scripts/browser-headed.js",
        "browser:verify": "playwright test tests/browser/setup.spec.ts",
        "browser:visual": "node scripts/browser-visual.js",
        "browser:interactive": "node tests/browser/interactive/cli.ts",
        "browser:interactive:headed": "node tests/browser/interactive/server.ts",
        "browser:interactive:diagnostics": "node tests/browser/interactive/cli.ts diagnostics",
        "browser:qa": "node tests/browser/interactive/cli.ts",
        "browser:open": "node --no-warnings tests/browser/interactive/launch-chrome.ts",
        "browser:mcp": "node --no-warnings tests/browser/interactive/mcp-server.ts",
        "test:mcp": "node --no-warnings tests/browser/interactive/mcp-test.ts",
        "test:parallel": "node scripts/run-parallel-tests.js",
        "test:coverage": "node scripts/validate-coverage-gate.js",
        "test:failed": "node scripts/rerun-failed-tests.js",
        "test:report": "node scripts/generate-dashboard-report.js",
        "test:release": "node scripts/run-release-gate.js"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.40.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0"
    }
}
