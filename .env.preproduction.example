# ==============================================================================
# Unique Distributors — Pre-Production Environment Configuration Template
# Target Stack: Render (Web Service) + Neon (PostgreSQL 18) + Upstash (Redis TLS) + Private AWS S3
# ==============================================================================
# All values in this template are SAFE PLACEHOLDERS. Never commit real credentials to Git.
# Supply these variables via the Render Dashboard environment settings or secret manager.

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME="Unique Distributors"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# ==============================================================================
# LOGGING & OBSERVABILITY
# ==============================================================================
# In containerized environments like Render, stdout/stderr is stream-captured.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Optional Sentry error and performance tracing
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL 18)
# ==============================================================================
# Option A: Full Connection String (Standard on Neon & Render)
# DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Discrete Parameters
DB_CONNECTION=pgsql
DB_HOST=ep-sample-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_SSLMODE=require

# ==============================================================================
# REDIS CONFIGURATION (Upstash Redis with TLS)
# ==============================================================================
# Option A: Full TLS URL provided by Upstash
# REDIS_URL=rediss://default:your_upstash_password@sample-endpoint.upstash.io:6379

# Option B: Discrete Parameters (Upstash requires TLS / rediss scheme)
REDIS_CLIENT=predis
REDIS_SCHEME=tls
REDIS_HOST=sample-endpoint.upstash.io
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_upstash_password_here

# ==============================================================================
# CACHE, SESSION & QUEUE STATE DRIVERS
# ==============================================================================
CACHE_STORE=redis
CACHE_PREFIX=wdms_preprod_cache_

# Session driver using Redis (or database fallback)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue driver using Redis (or database)
QUEUE_CONNECTION=redis

# ==============================================================================
# CANONICAL FILE STORAGE (Private AWS S3)
# ==============================================================================
# Render ephemeral disk must NOT store persistent business assets.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=unq-distributors-files-preprod-537124933486-us-east-1-an
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_THROW=true

# ==============================================================================
# MAIL SAFETY (Pre-Production Sandbox / Log)
# ==============================================================================
# Prevent accidental customer-facing emails. Default to log or a sandbox provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@uniquedistributors.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# REVERSE PROXY & SECURITY HEADERS
# ==============================================================================
# Trust Render's upstream HTTPS reverse proxy
TRUSTED_PROXIES=*

# ==============================================================================
# FRONTEND BUILD CONFIGURATION (Vite)
# ==============================================================================
# ONLY browser-safe public variables may be prefixed with VITE_.
# NEVER expose AWS secrets or database credentials to VITE_!
VITE_APP_NAME="${APP_NAME}"
