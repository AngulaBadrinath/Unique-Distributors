# ==============================================================================
# Unique Distributors — Environment Configuration Template
# ==============================================================================
# All values here are safe developer placeholders. Never commit production secrets.

# --- Application Configuration ---
APP_NAME="Unique Distributors"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# --- Logging & Error Handling Baseline ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database Configuration (PostgreSQL 18 Local Container) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=wdms
DB_USERNAME=wdms_user
DB_PASSWORD=your_db_password_here
FORWARD_DB_PORT=5433

# --- Redis Configuration (Redis 7 Local Container) ---
REDIS_CLIENT=predis
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6380
FORWARD_REDIS_PORT=6380

# --- State, Cache & Queue Drivers ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=wdms_cache_

QUEUE_CONNECTION=redis

# --- Storage Configuration (S3 / Local Architecture-Ready) ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_CA_BUNDLE=

# --- Mail Configuration (SES-Compatible Architecture-Ready) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wdms.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Monitoring & Observability (Sentry / CloudWatch Ready) ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Frontend Build Configuration (Vite) ---
VITE_APP_NAME="${APP_NAME}"
